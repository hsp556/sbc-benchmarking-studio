# Copy this file to office.env (same folder) and fill it in. office.env is read by "Start Studio" and "Start Runner".
# Keep office.env private: it holds the runner token and the Studio password.

# --- On the Studio PC ---
# 0.0.0.0 lets other office PCs reach the Studio. Leave as 127.0.0.1 to use it on this PC only.
HOST=127.0.0.1
PORT=3000
# Password the website asks for (8 characters or more). Needed when HOST is not 127.0.0.1.
# Use letters and digits only: a # cuts the value off (the rest of the line is read as a comment).
STUDIO_PASSWORD=

# --- On the Studio PC and on every runner PC (the same value) ---
# 24 characters or more. Make one with:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
RUNNER_TOKEN=

# --- On every runner PC ---
# The Studio's address as seen from this PC, for example http://192.168.1.20:3000
STUDIO_URL=http://127.0.0.1:3000
# The name shown on the Agents tab
RUNNER_NAME=Office PC 1
# Optional. A SharePoint library synced to this PC with OneDrive (the "Sync" button in SharePoint). Every export is
# copied into this folder and OneDrive uploads it. The folder must already exist. Write the path as it is, without
# quotes; it may contain spaces but not a #. Example: C:\Users\you\SBC\Benchmarking - Documents\TP Catalyst
SHAREPOINT_DIR=
